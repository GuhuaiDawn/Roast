<Window x:Class="DesktopNarrator.App.DeveloperLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopNarrator.App"
        x:Name="ActivityWindow" Title="Desktop Narrator · 桌面足迹"
        Width="1280" Height="820" MinWidth="900" MinHeight="640"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DarkTheme.xaml" /></ResourceDictionary.MergedDictionaries>
            <local:ActivityDisplayConverter x:Key="Display" />
            <local:UsageShareConverter x:Key="UsageShare" />
            <!-- 正常状态不占位；只有读取/写入异常才在概览底部提示。 -->
            <Style x:Key="OverviewNotice" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="Foreground" Value="#EBC58B" /><Setter Property="Margin" Value="0,12,0,0" />
                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="NavigationItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="48" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <!-- A 方案的左侧导航；数据页与诊断页共享一份真实状态，未加入新的系统采样。 -->
    <TabControl x:Name="LogTabs" SelectionChanged="OnHistorySelected" TabStripPlacement="Left"
                ItemContainerStyle="{StaticResource NavigationItem}" Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid Background="{StaticResource PageBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                        <Grid Margin="14,24,14,16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Margin="8,0,0,30">
                                <Border Width="36" Height="36" HorizontalAlignment="Left" Background="#7257C7" CornerRadius="10" Margin="0,0,0,12">
                                    <TextBlock Text="▥" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Desktop" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Narrator" Foreground="{StaticResource MutedBrush}" FontSize="15" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" IsItemsHost="True" KeyboardNavigation.TabNavigation="Local" />
                            <StackPanel Grid.Row="2" Margin="8,16,0,0">
                                <TextBlock Text="桌面足迹 · 本地记录" Style="{StaticResource SecondaryText}" />
                                <TextBlock Margin="0,6,0,0" Text="尚未接入 AI 旁白" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="24,22" ContentSource="SelectedContent" TextElement.Foreground="{StaticResource TextBrush}" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
        <TabItem x:Name="HistoryTab" Header="活动概览" IsSelected="True">
            <Grid TextElement.Foreground="{StaticResource TextBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="OverviewTitle" Text="今日概览" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0" Text="看看时间停留在哪些应用" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <DatePicker x:Name="HistoryDate" Width="140" SelectedDateChanged="OnHistoryDateChanged" ToolTip="选择要回顾的日期" />
                        <Button x:Name="RefreshHistoryButton" Content="刷新" Click="OnRefreshHistory" Margin="8,0,0,0" />
                    </WrapPanel>
                </Grid>
                <Border Grid.Row="1" Background="#28273D" BorderBrush="#484064" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="当前前台" Foreground="{StaticResource AccentBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <!-- 概要来自已有会话状态；不把进行中时长混入历史卡片。 -->
                        <TextBlock x:Name="CurrentSessionText" Grid.Column="1" Text="{Binding CurrentSessionSummary}" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel><TextBlock Text="已保存前台时长" Style="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="TotalDurationText" Margin="0,10,0,0" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding Overview.DurationText, ElementName=ActivityWindow, TargetNullValue=—, FallbackValue=—}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel><TextBlock Text="应用" Style="{StaticResource SecondaryText}" />
                            <TextBlock Margin="0,10,0,0" FontSize="25" FontWeight="SemiBold"
                                       Text="{Binding Overview.ApplicationCount, ElementName=ActivityWindow, StringFormat={}{0} 个, TargetNullValue=—, FallbackValue=—}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel><TextBlock Text="已结束会话" Style="{StaticResource SecondaryText}" />
                            <TextBlock Margin="0,10,0,0" FontSize="25" FontWeight="SemiBold"
                                       Text="{Binding Overview.SessionCount, ElementName=ActivityWindow, StringFormat={}{0} 段, TargetNullValue=—, FallbackValue=—}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4*" MinWidth="260" /><ColumnDefinition Width="16" /><ColumnDefinition Width="6*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="应用分布" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- 扇区和图例共享同一快照，颜色、时长与占比保持一致。 -->
                                    <local:ApplicationPieChart x:Name="UsagePie" Width="180" Height="180" Margin="0,4,0,16"
                                        Slices="{Binding Distribution, ElementName=ActivityWindow}" AutomationProperties.Name="应用时长分布扇形图，详情见下方图例" />
                                    <DataGrid x:Name="DailyTotalsGrid" ItemsSource="{Binding Distribution, ElementName=ActivityWindow}"
                                              AutomationProperties.Name="应用分布图例" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns><DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8" ToolTip="{Binding Details}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DurationText}" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding ShareText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="活动时间线" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="最近的在上方 · 每段显示完整时长" Margin="0,5,0,12" Style="{StaticResource SecondaryText}" />
                            <DataGrid x:Name="SessionHistoryGrid" Grid.Row="2" AutomationProperties.Name="已保存活动时间线">
                                <DataGrid.Columns><DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Converter={StaticResource Display}, ConverterParameter=Details}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="2" Background="#51496D" HorizontalAlignment="Center" />
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,23,0,0" />
                                            <Border Grid.Column="1" Background="#273141" CornerRadius="8" Margin="8,5,0,5" Padding="14,12">
                                                <StackPanel>
                                                    <TextBlock x:Name="SessionTimeRange" Text="{Binding Converter={StaticResource Display}, ConverterParameter=Range}"
                                                               FontFamily="Consolas, Microsoft YaHei UI" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Converter={StaticResource Display}, ConverterParameter=App}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="SessionDuration" Grid.Column="1" MaxWidth="160" Margin="12,0,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding Duration, Converter={StaticResource Display}, ConverterParameter=Duration}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="HistoryEmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="12">
                                <TextBlock Text="这一天还没有已保存记录" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock Text="当前会话结束并成功写入后，会出现在这里。" Margin="0,8,0,0" TextAlignment="Center" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="PreviousHistoryButton" Content="上一页" Click="OnPreviousHistory" Padding="10,6" />
                                    <Button x:Name="NextHistoryButton" Content="下一页" Click="OnNextHistory" Margin="6,0,0,0" Padding="10,6" />
                                </StackPanel>
                                <TextBlock x:Name="HistoryPageText" Text="每页 100 条" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="4">
                    <TextBlock x:Name="HistoryStatus" Style="{StaticResource OverviewNotice}" />
                    <TextBlock x:Name="PersistenceNotice" Text="{Binding PersistenceWarning}" Style="{StaticResource OverviewNotice}" />
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem x:Name="PatternsTab" Header="观察发现">
            <Grid TextElement.Foreground="{StaticResource TextBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="2*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="观察发现" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="只描述发生了什么，不评价你的效率或意图。" Margin="0,6,0,12" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding EvaluationSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="本次运行最近 200 条 · 选择一条查看原因 · 通过初筛不代表已发送旁白" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding PersistenceSummary}" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <DataGrid x:Name="PatternList" ItemsSource="{Binding Patterns}" AutomationProperties.Name="观察发现列表">
                            <DataGrid.Columns><DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,12" ToolTip="{Binding Type}">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding EndTime, StringFormat=MM-dd HH:mm:ss}" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding DisplayDecision}" Foreground="{Binding DecisionColor}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ReadableSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="还没有发现明显的活动模式。达到规则条件后，记录会显示在这里。" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="32" Foreground="{StaticResource MutedBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                <DataTrigger Binding="{Binding Patterns.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}" ToolTip="拖动调整列表和详情的高度" />
                <TabControl Grid.Row="3" Background="{StaticResource PageBrush}" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                    <TabItem Header="为什么出现">
                        <TextBox x:Name="ReadablePatternDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding SelectedItem.ReadableDetails, ElementName=PatternList, Mode=OneWay, TargetNullValue=选择一条观察，查看事实与初筛原因。}" />
                    </TabItem>
                    <TabItem x:Name="EvidenceTab" Header="原始证据">
                        <TextBox x:Name="PatternEvidence" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding SelectedItem.EvidenceJson, ElementName=PatternList, Mode=OneWay}" />
                    </TabItem>
                    <TabItem x:Name="ScoreDetailsTab" Header="技术评分快照">
                        <TextBox x:Name="PatternEvaluationDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding SelectedItem.EvaluationDetails, ElementName=PatternList, Mode=OneWay}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>
        <TabItem x:Name="DebugTab" Header="开发日志">
            <Grid TextElement.Foreground="{StaticResource TextBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="开发日志" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="本次运行的原始事件与诊断信息，供排查问题；不是已保存历史。" Margin="0,8,0,8" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding CurrentSessionSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PersistenceSummary}" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <!-- 原始日志只在可见时延后滚动，避免集合通知内触发布局重入。 -->
                <ListBox x:Name="LogList" Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                         Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                         Padding="10" ItemsSource="{Binding Entries}" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
