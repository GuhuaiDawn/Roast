<Window x:Class="DesktopNarrator.App.DeveloperLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Narrator · Developer Log"
        Width="760"
        Height="480"
        MinWidth="520"
        MinHeight="300"
        Background="#11151B"
        Foreground="#E7EDF5"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Developer Log" />
            <TextBlock Margin="0,4,0,0" Foreground="#9CA9B8"
                       Text="Milestone 1–4 · 前台会话与空闲/返回事件 · 会话含无输入时段" />
            <!-- 概要只随会话状态更新；不在 UI 层额外轮询前台窗口或累计活动时间。 -->
            <TextBlock x:Name="CurrentSessionText" Margin="0,8,0,0" Foreground="#B8D8F0"
                       TextWrapping="Wrap" Text="{Binding CurrentSessionSummary}" />
        </StackPanel>

        <!-- 只绑定日志集合；滚动在代码侧延后调度，避免集合变更期间触发布局重入。 -->
        <ListBox x:Name="LogList"
                 Grid.Row="1"
                 Background="#171D25"
                 BorderBrush="#2C3745"
                 Foreground="#DDE6F0"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="13"
                 ItemsSource="{Binding Entries}" />
    </Grid>
</Window>
